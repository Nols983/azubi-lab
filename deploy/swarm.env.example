# Non-secret operator configuration for `docker stack deploy`.
# Source this file in the manager shell; Docker Stack does not load it automatically.
AZUBI_LAB_IMAGE=azubi-lab:<git-sha>
AZUBI_LAB_POSTGRES_IMAGE=postgres:17
AZUBI_LAB_APP_REPLICAS=1
AZUBI_LAB_HOST=
TRAEFIK_CERTRESOLVER=
AZUBI_LAB_PUBLIC_HOST=
TRAEFIK_PUBLIC_CERTRESOLVER=
AUTH_TRUST_HOST=true
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:operator@example.test
POSTGRES_DB=azubi_lab
POSTGRES_USER=azubi_lab
AZUBI_LAB_DATABASE_URL_SECRET=azubi-lab-database-url-v1
AZUBI_LAB_AUTH_SECRET=azubi-lab-auth-secret-v1
AZUBI_LAB_WEB_PUSH_VAPID_PRIVATE_KEY_SECRET=azubi-lab-web-push-vapid-private-key-v1
AZUBI_LAB_POSTGRES_PASSWORD_SECRET=azubi-lab-postgres-password-v1
AZUBI_LAB_STACK_DIR=/srv/azubi-lab/app
AZUBI_LAB_STACK_FILE=/srv/azubi-lab/app/deploy/swarm-stack.yml
